__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# === 推理结果与日志 (运行产物, 不上传) ===
results/
*.log

# === 训练运行输出 (checkpoint/日志, 不上传) ===
runs/

# === IDE 配置 ===
.idea/
.vscode/
*.iml

# === 系统文件 ===
.DS_Store
Thumbs.db

# === 环境变量 ===
.env
.env.local
